{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "ApplicationInsights": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "AcsConnectionString": "",
  "AcsPhoneNumber": "",
  "AzureOpenAI": {
    "Endpoint": "",
    "DeploymentName": "gpt-realtime",
    "AnalysisDeploymentName": "gpt-5.4-nano"
  },
  "Voice": {
    "// Notes": "Mirrors danish-voice-lab (the console sandbox the user has tuned). OpenAI 'ash' voice with gpt-realtime — natural, multilingual, and proven to sound right on Danish phone calls. Switch Type to 'azure-standard' + Name 'da-DK-ChristelNeural' if you specifically want a native da-DK neural voice.",
    "Type": "openai",
    "Name": "ash",
    "Temperature": 0.8,
    "EndpointId": ""
  },
  "VoiceLive": {
    "// Notes": "Mirrors danish-voice-lab defaults. Spec defaults: Threshold=0.5, PrefixPaddingMs=300, SilenceDurationMs=500, InterruptResponse=true.",
    "Vad": {
      "// Type": "azure_semantic_vad (console default) | azure_semantic_vad_multilingual (legacy phone-tuned) | server_vad",
      "Type": "azure_semantic_vad",
      "// Threshold": "Speech-detection probability 0.0-1.0. 0.3 matches console; raise toward 0.7 only if PSTN background noise causes false barge-ins.",
      "Threshold": 0.3,
      "// PrefixPaddingMs": "Audio buffered BEFORE the speech-onset point.",
      "PrefixPaddingMs": 300,
      "// SilenceDurationMsEnglish": "End-of-turn silence for English callers.",
      "SilenceDurationMsEnglish": 500,
      "// SilenceDurationMsOther": "End-of-turn silence for non-English callers (Danish etc.).",
      "SilenceDurationMsOther": 500,
      "// InterruptResponse": "If true, caller speech immediately stops the bot mid-sentence (barge-in).",
      "InterruptResponse": true
    }
  },
  "Transcription": {
    "// Notes": "Azure Speech (da-DK) + Norlys phrase_list — the only STT we use in production (mirrors danish-voice-lab). Other models (whisper-1, gpt-4o-transcribe) exist in the SDK but are NOT used here; if you ever want to A/B test one, set Transcription:Model and switch phrase_list → prompt accordingly. Note: this transcript is a sidecar pass and can diverge from what gpt-realtime actually heard — the model has its own native ASR.",
    "Model": "azure-speech",
    "Language": "da-DK",
