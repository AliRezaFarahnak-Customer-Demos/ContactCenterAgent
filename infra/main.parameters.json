{
  "$schema": "https://schema.management.azure.com/schemas/2018-05-01/subscriptionDeploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "customDomain": {
      "value": "${CUSTOM_DOMAIN=}"
    },
    "customDomainWww": {
      "value": "${CUSTOM_DOMAIN_WWW=}"
    },
    "acsPhoneNumber": {
      "value": "${ACS_PHONE_NUMBER=}"
    },
    "acsSmsNumber": {
      "value": "${ACS_SMS_NUMBER=}"
    },
    "graphSenderAddress": {
      "value": "${GRAPH_SENDER_ADDRESS=}"
    },
    "preferAcsEmailDelivery": {
      "value": "${PREFER_ACS_EMAIL_DELIVERY=false}"
    },
    "acsDataLocation": {
      "value": "${ACS_DATA_LOCATION=United States}"
    },
    "resourceNameSuffix": {
      "value": "${RESOURCE_NAME_SUFFIX=}"
    },
    "lunaCapacity": {
      "value": "${AOAI_LUNA_CAPACITY=150}"
    },
    "realtimeCapacity": {
      "value": "${AOAI_REALTIME_CAPACITY=10}"
    },
    "smsConnectionString": {
      "value": "${SMS_CONNECTION_STRING=}"
    },
    "acsConnectionStringOverride": {
      "value": "${ACS_CONNECTION_STRING_OVERRIDE=}"
    },
    "acsSmsSenderId": {
      "value": "${ACS_SMS_SENDER_ID=}"
    },
    "messagingConnectApiKey": {
      "value": "${MESSAGING_CONNECT_API_KEY=}"
    },
    "messagingConnectSender": {
      "value": "${MESSAGING_CONNECT_SENDER=}"
    }
  }
}
